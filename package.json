{
  "name": "zorko-sangli",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run test:db:reset && vitest run --config vitest.integration.config.mts tests/integration",
    "test:supabase": "vitest run --config vitest.integration.config.mts tests/supabase",
    "test:e2e": "npm run test:db:reset && npm run test:db:reco && playwright test",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run build",
    "postinstall": "prisma generate",
    "preflight": "node scripts/preflight.mjs",
    "scan:build": "node scripts/scan-build.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:remove-demo": "tsx prisma/remove-demo.ts",
    "test:db:up": "./scripts/test-db.sh up",
    "test:db:reset": "./scripts/test-db.sh reset",
    "test:db:reco": "./scripts/test-db.sh reco",
    "test:db:down": "./scripts/test-db.sh down",
    "db:import-menu": "tsx prisma/import-menu.ts",
    "admin:add": "tsx prisma/admin-allowlist.ts add",
    "admin:disable": "tsx prisma/admin-allowlist.ts disable",
    "admin:list": "tsx prisma/admin-allowlist.ts list",
    "gallery:outlet-photos": "tsx prisma/outlet-photos.ts",
    "reco:tags": "tsx prisma/reco-tags.ts",
    "reco:generate": "tsx prisma/reco-generate.ts",
    "reco:export": "tsx prisma/reco-export.ts",
    "reco:train": "tsx prisma/reco-train.ts",
    "reco:validate": "node scripts/reco-validate.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "1.56.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6"
  }
}
