// ZORKO Sangli — database schema (TRD §4).
//
// Conventions:
// - IDs are cuid strings; every content model has createdAt/updatedAt.
// - Money is always an Int in paise (₹1 = 100 paise). Never floats.
// - `isDemo` marks seeded demonstration rows so they can be found and replaced (CLAUDE.md §14).
// - CHECK constraints and Row Level Security live in the hand-written
//   migration `*_security_rls` because Prisma cannot express them.
// - Connection URLs live in prisma.config.ts (migrations) and src/server/db.ts (runtime), per Prisma 7.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoryIcon {
  BURGER
  PIZZA
  PASTA
  SNACKS
  SANDWICH
  BEVERAGE
  COFFEE
  DESSERT
  MEAL
  GENERAL
}

enum DietType {
  VEG
  NON_VEG
  EGG
}

enum ItemRelationType {
  RELATED
  FREQUENTLY_BOUGHT_TOGETHER
}

enum OfferKind {
  DISCOUNT
  COMBO
  INFO
}

enum FeedbackStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Quick highlights a guest can tick on the feedback form (Round 2D, ADR-062).
enum FeedbackTag {
  TASTY_FOOD
  QUICK_SERVICE
  FRIENDLY_STAFF
  GREAT_AMBIENCE
  GOOD_VALUE
  STUDENT_FRIENDLY
}

/// Descriptive flavour/style tags on menu items (recommendations, ADR-069). Not dietary claims.
enum FlavorTag {
  SPICY
  CHEESY
  KOREAN
  PERI_PERI
  ITALIAN
  MEXICAN
  SMOKY
  PANEER
  CREAMY
  FRUITY
  CHOCOLATE
  COFFEE
  MINTY
}

/// What a category's dishes are in a meal; "Goes well with" pairs different roles (ADR-069).
enum MealRole {
  MAIN
  SIDE
  DRINK
  DESSERT
}

/// Time of day of a demo visit (IST): LUNCH 11–14, AFTERNOON 14–17, EVENING 17–22.
enum Daypart {
  LUNCH
  AFTERNOON
  EVENING
}

/// Popularity window: one of the dayparts, or ALL.
enum RecoWindow {
  ALL
  LUNCH
  AFTERNOON
  EVENING
}

enum RatingSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum RecoRunStatus {
  TRAINING
  ACTIVE
  ARCHIVED
  REJECTED
  FAILED
}

/// Where a model run's training data came from (RECOMMENDATION §7). Only DEMO_FEEDBACK exists now.
enum RecoDataSource {
  DEMO_FEEDBACK
  REAL_FEEDBACK
  POS
}

enum RecoListKind {
  COMPLEMENT
  SIMILAR
}

/// Fixed public reason codes (RECOMMENDATION §6). Labels are built from real menu data only.
enum RecoReason {
  PAIRS_WITH_ROLE
  SHARED_TAGS
  SAME_CATEGORY
  IN_BUDGET
  BEST_SELLER
  TRENDING
  ADMIN_PICK
}

model MenuCategory {
  id          String       @id @default(cuid())
  name        String       @db.VarChar(60)
  slug        String       @unique @db.VarChar(70)
  description String?      @db.VarChar(200)
  iconKey     CategoryIcon @default(GENERAL)
  mealRole    MealRole     @default(MAIN)
  sortOrder   Int          @default(0)
  isArchived  Boolean      @default(false)
  isDemo      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items MenuItem[]

  @@index([isArchived, sortOrder])
}

model MenuItem {
  id           String      @id @default(cuid())
  categoryId   String
  name         String      @db.VarChar(80)
  slug         String      @unique @db.VarChar(90)
  description  String      @db.VarChar(600)
  pricePaise   Int
  dietType     DietType    @default(VEG)
  isAvailable  Boolean     @default(true)
  isPublished  Boolean     @default(true)
  isArchived   Boolean     @default(false)
  isBestSeller Boolean     @default(false)
  isTrending   Boolean     @default(false)
  isFeatured   Boolean     @default(false)
  sortOrder    Int         @default(0)
  /// Max 5 (Zod + CHECK). Descriptive only (ADR-069).
  flavorTags   FlavorTag[] @default([])
  isDemo       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  category      MenuCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        MenuItemImage[]
  addOnGroups   AddOnGroup[]
  relationsFrom ItemRelation[]       @relation("RelationFrom")
  relationsTo   ItemRelation[]       @relation("RelationTo")
  offers        OfferMenuItem[]
  demoRatings   DemoRating[]
  recoFrom      ItemRecommendation[] @relation("RecoFrom")
  recoTo        ItemRecommendation[] @relation("RecoTo")
  popularity    ItemPopularity[]

  @@index([isPublished, isArchived, categoryId, sortOrder])
  @@index([isBestSeller, isTrending])
  @@index([pricePaise])
}

model MenuItemImage {
  id          String   @id @default(cuid())
  menuItemId  String
  storagePath String   @db.VarChar(200)
  altText     String   @db.VarChar(150)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, sortOrder])
}

model AddOnGroup {
  id         String   @id @default(cuid())
  menuItemId String
  name       String   @db.VarChar(60)
  minSelect  Int      @default(0)
  maxSelect  Int      @default(1)
  isRequired Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  menuItem MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  AddOnOption[]

  @@index([menuItemId, sortOrder])
}

model AddOnOption {
  id              String   @id @default(cuid())
  groupId         String
  name            String   @db.VarChar(60)
  priceDeltaPaise Int      @default(0)
  isAvailable     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group AddOnGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

/// Admin-managed associations ("Related", "Frequently Bought Together"). Not analytics.
model ItemRelation {
  id         String           @id @default(cuid())
  fromItemId String
  toItemId   String
  type       ItemRelationType
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  fromItem MenuItem @relation("RelationFrom", fields: [fromItemId], references: [id], onDelete: Cascade)
  toItem   MenuItem @relation("RelationTo", fields: [toItemId], references: [id], onDelete: Cascade)

  @@unique([fromItemId, toItemId, type])
  @@index([toItemId])
}

model Offer {
  id              String    @id @default(cuid())
  kind            OfferKind
  title           String    @db.VarChar(80)
  slug            String    @unique @db.VarChar(90)
  description     String    @db.VarChar(600)
  imagePath       String?   @db.VarChar(200)
  /// Null only for INFO offers (enforced by a CHECK constraint).
  promoPricePaise Int?
  startsAt        DateTime
  endsAt          DateTime
  /// Set when an admin expires an offer early; an offer is expired if now >= endsAt or expiredAt is set.
  expiredAt       DateTime?
  isPublished     Boolean   @default(false)
  isStudentOffer  Boolean   @default(false)
  isFeatured      Boolean   @default(false)
  sortOrder       Int       @default(0)
  isDemo          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items OfferMenuItem[]

  @@index([isPublished, startsAt, endsAt])
}

model OfferMenuItem {
  offerId    String
  menuItemId String
  quantity   Int    @default(1)

  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@id([offerId, menuItemId])
  @@index([menuItemId])
}

model PromotionalBanner {
  id          String    @id @default(cuid())
  title       String    @db.VarChar(80)
  subtitle    String?   @db.VarChar(160)
  imagePath   String    @db.VarChar(200)
  altText     String    @db.VarChar(150)
  ctaLabel    String?   @db.VarChar(30)
  ctaHref     String?   @db.VarChar(300)
  startsAt    DateTime?
  endsAt      DateTime?
  isPublished Boolean   @default(false)
  sortOrder   Int       @default(0)
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, sortOrder])
}

/// Singleton row with id "cafe". Every value is configurable; `*Verified` flags say whether the
/// café has confirmed it, so the UI can label unverified values as placeholders.
model CafeInformation {
  id                 String   @id @default("cafe")
  name               String   @db.VarChar(80)
  addressLine        String   @db.VarChar(200)
  city               String   @db.VarChar(60)
  postalCode         String?  @db.VarChar(10)
  phone              String?  @db.VarChar(20)
  email              String?  @db.VarChar(120)
  /// E.164 digits only, no "+" (used to build https://wa.me/<digits>).
  whatsappNumber     String?  @db.VarChar(15)
  instagramUrl       String?  @db.VarChar(300)
  facebookUrl        String?  @db.VarChar(300)
  latitude           Decimal? @db.Decimal(9, 6)
  longitude          Decimal? @db.Decimal(9, 6)
  /// Place name/address exactly as listed on Google Maps, e.g. "Cafe Zorko, 100 Feet Rd, …".
  /// Map and directions use it first, so Google opens the business listing (ADR-046).
  mapsQuery          String?  @db.VarChar(200)
  aboutText          String?  @db.VarChar(1000)
  studentZoneText    String?  @db.VarChar(1000)
  offerTerms         String?  @db.VarChar(1000)
  isPureVegConfirmed Boolean  @default(false)
  addressVerified    Boolean  @default(false)
  contactVerified    Boolean  @default(false)
  hoursVerified      Boolean  @default(false)
  mapVerified        Boolean  @default(false)
  socialVerified     Boolean  @default(false)
  isDemo             Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// One row per weekday (0 = Sunday). Minutes from midnight, IST.
model OpeningHours {
  id          String   @id @default(cuid())
  dayOfWeek   Int      @unique
  opensAtMin  Int      @default(0)
  closesAtMin Int      @default(0)
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryImage {
  id          String   @id @default(cuid())
  storagePath String   @db.VarChar(200)
  altText     String   @db.VarChar(150)
  caption     String?  @db.VarChar(120)
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model Feedback {
  id            String         @id @default(cuid())
  displayName   String?        @db.VarChar(40)
  message       String         @db.VarChar(1000)
  tags          FeedbackTag[]  @default([])
  status        FeedbackStatus @default(PENDING)
  moderatedAt   DateTime?
  moderatedById String?
  isDemo        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  moderatedBy AdminUser? @relation(fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/// Admin allowlist. A Supabase login alone is not enough; the user must have an active row here.
model AdminUser {
  id          String    @id @default(cuid())
  authUserId  String    @unique @db.Uuid
  email       String    @unique @db.VarChar(254)
  displayName String?   @db.VarChar(60)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  auditLogs         AuditLog[]
  moderatedFeedback Feedback[]
  recoRuns          RecoModelRun[]
}

/// Append-only record of admin actions (no updatedAt). Never contains secrets.
model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String   @db.VarChar(40)
  entityType  String   @db.VarChar(40)
  entityId    String?  @db.VarChar(40)
  summary     String   @db.VarChar(300)
  createdAt   DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

/// Shared fixed-window rate-limit counters (ADR: Postgres-backed limiter, works on serverless).
model RateLimitBucket {
  id          String   @id @default(cuid())
  /// HMAC-SHA256 hex of the client key; raw IPs are never stored.
  key         String   @db.VarChar(64)
  scope       String   @db.VarChar(30)
  windowStart DateTime
  count       Int      @default(0)

  @@unique([key, scope, windowStart])
  @@index([windowStart])
}

// ---------------------------------------------------------------- Recommendations (Phase R1)
// Demo feedback dataset (RECOMMENDATION §3, ADR-071). Generated, never shown publicly and kept
// apart from the real `Feedback` table. Demo users are plain numbers (no personal data).
// Rows are immutable (replaced as a whole by `reco:generate --replace`), so no updatedAt.

model DemoVisit {
  id               String   @id @default(cuid())
  /// `visit_id` in the CSV export.
  visitNo          Int      @unique
  demoUserNo       Int      @db.SmallInt
  visitedAt        DateTime
  daypart          Daypart
  pattern          String   @db.VarChar(40)
  generatorVersion Int      @db.SmallInt
  isDemo           Boolean  @default(true)
  createdAt        DateTime @default(now())

  ratings DemoRating[]

  @@index([visitedAt])
  @@index([demoUserNo])
}

model DemoRating {
  id         String          @id @default(cuid())
  /// `feedback_id` in the CSV export.
  feedbackNo Int             @unique
  visitId    String
  demoUserNo Int             @db.SmallInt
  menuItemId String
  rating     Int             @db.SmallInt
  sentiment  RatingSentiment
  comment    String          @db.VarChar(200)
  ratedAt    DateTime
  isDemo     Boolean         @default(true)
  createdAt  DateTime        @default(now())

  visit    DemoVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  // Cascade: demo rows must never block an admin's hard delete of a dish.
  menuItem MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([demoUserNo, menuItemId])
  @@unique([visitId, menuItemId])
  @@index([menuItemId])
}

/// One training run (RECOMMENDATION §5). Weights are per-mille (0–1000), renormalised when used.
model RecoModelRun {
  id                 String         @id @default(cuid())
  version            Int            @unique @default(autoincrement())
  status             RecoRunStatus  @default(TRAINING)
  dataSource         RecoDataSource
  compCoocPm         Int            @db.SmallInt
  compQualityPm      Int            @db.SmallInt
  compContentPm      Int            @db.SmallInt
  simContentPm       Int            @db.SmallInt
  simTastePm         Int            @db.SmallInt
  simQualityPm       Int            @db.SmallInt
  ratingCount        Int
  visitCount         Int
  itemCount          Int
  rmse               Float?
  mae                Float?
  hitRate5Complement Float?
  hitRate5Similar    Float?
  precision5         Float?
  recall5            Float?
  coverage           Float?
  baselineHitRate5   Float?
  gateReason         String?        @db.VarChar(200)
  durationMs         Int?
  startedById        String?
  trainedAt          DateTime?
  activatedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  startedBy       AdminUser?           @relation(fields: [startedById], references: [id], onDelete: SetNull)
  recommendations ItemRecommendation[]
  popularity      ItemPopularity[]
  activeIn        RecoSettings?

  @@index([status, createdAt])
}

/// Precomputed top-10 lists per dish and kind for one run.
model ItemRecommendation {
  runId        String
  fromItemId   String
  toItemId     String
  kind         RecoListKind
  rank         Int          @db.SmallInt
  score        Float
  contentScore Float
  tasteScore   Float
  coocScore    Float
  qualityScore Float
  reasons      RecoReason[] @default([])

  run      RecoModelRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  fromItem MenuItem     @relation("RecoFrom", fields: [fromItemId], references: [id], onDelete: Cascade)
  toItem   MenuItem     @relation("RecoTo", fields: [toItemId], references: [id], onDelete: Cascade)

  @@id([runId, fromItemId, kind, rank])
  @@unique([runId, fromItemId, kind, toItemId])
  @@index([toItemId])
}

/// Quality/popularity score per dish and window for one run (Help me choose, fallbacks).
model ItemPopularity {
  runId      String
  menuItemId String
  window     RecoWindow
  score      Float

  run      RecoModelRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  menuItem MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([runId, menuItemId, window])
  @@index([menuItemId])
}

/// Singleton (id = "reco"). Off until the team switches it on (R4/R5).
model RecoSettings {
  id                String    @id @default("reco")
  enabled           Boolean   @default(false)
  compCoocPm        Int       @default(600) @db.SmallInt
  compQualityPm     Int       @default(250) @db.SmallInt
  compContentPm     Int       @default(150) @db.SmallInt
  simContentPm      Int       @default(500) @db.SmallInt
  simTastePm        Int       @default(300) @db.SmallInt
  simQualityPm      Int       @default(200) @db.SmallInt
  activeRunId       String?   @unique
  trainingLockUntil DateTime?
  retrainPending    Boolean   @default(false)
  updatedAt         DateTime  @updatedAt

  activeRun RecoModelRun? @relation(fields: [activeRunId], references: [id], onDelete: SetNull)
}
